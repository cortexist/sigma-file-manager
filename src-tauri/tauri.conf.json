{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Sigma File Manager",
  "version": "../package.json",
  "identifier": "com.sigma-file-manager.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "plugins": {
    "fs": {
      "requireLiteralLeadingDot": false
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Sigma File Manager",
        "width": 1280,
        "height": 720,
        "minWidth": 500,
        "minHeight": 300,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "visible": false,
        "backgroundColor": "#242227"
      },
      {
        "label": "quick-view",
        "create": false,
        "title": "Sigma Quick View",
        "width": 1280,
        "height": 720,
        "minWidth": 300,
        "minHeight": 200,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "shadow": true,
        "visible": false,
        "url": "/quick-view"
      },
      {
        "label": "file-picker",
        "create": false,
        "title": "Open",
        "width": 920,
        "height": 620,
        "minWidth": 480,
        "minHeight": 360,
        "resizable": true,
        "decorations": false,
        "shadow": true,
        "visible": false,
        "url": "/file-picker"
      },
      {
        "label": "print-view",
        "create": false,
        "title": "Sigma File Manager | Print",
        "width": 1280,
        "height": 720,
        "minWidth": 300,
        "minHeight": 200,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "shadow": true,
        "visible": false,
        "url": "/print-view"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "requireLiteralLeadingDot": false,
          "allow": [
            "**",
            "$APPDATA/**"
          ]
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "deb"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libayatana-appindicator3-1",
          "gstreamer1.0-plugins-base",
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-plugins-bad",
          "gstreamer1.0-libav"
        ],
        "recommends": [
          "gstreamer1.0-plugins-ugly",
          "gstreamer1.0-pipewire"
        ]
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}